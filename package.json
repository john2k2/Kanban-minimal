{
  "name": "kanban-minimal",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --update-snapshots --config=playwright.config.ts",
    "ci": "npm run lint && npm run test:unit && npm run test:visual"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "^24.10.1",
    "@types/react": "18.3.5",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.2.0",
    "postcss": "8.4.41",
    "tailwindcss": "4.1.13",
    "typescript": "5.5.4",
    "vitest": "^4.0.15"
  }
}
